{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeExplanation (contract v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "message",
    "items"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": [
        "EXPLAINED",
        "NO_CHANGES"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "kind",
        "text"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "added",
            "updated",
            "deleted"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "EXPLAINED"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "items": {
        "minItems": 1
      }
    }
  },
  "else": {
    "properties": {
      "items": {
        "maxItems": 0
      }
    }
  }
}

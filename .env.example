# По умолчанию используется FakeLLMGateway: сеть и ключ не нужны.
LLM_PROVIDER=fake
LLM_MODEL=fake
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Для реальной LLM (OpenAI) указать LLM_PROVIDER=openai и LLM_MODEL.
# OPENAI_API_KEY задаётся только как переменная окружения, НЕ в git/.env.example.
# OPENAI_BASE_URL=https://api.openai.com/v1
